{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:githubActionsVersions",
    "helpers:pinGitHubActionDigests"
  ],
  "fetchChangeLogs": "off",
  "prBodyColumns": [
    "Package",
    "Update",
    "Change"
  ],
  "prCreation": "immediate",
  "prConcurrentLimit": 1,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "matchDepTypes":[
        "action"
      ],
      "matchCurrentAge": "> 5 days",
      "automerge": true
    },
    {
      "matchDatasources": [
        "npm"
      ],
      "matchDepNames": [
        "renovate"
      ],
      "schedule": [
        "* * * * 0"
      ]
    }
  ],
  "rangeStrategy": "bump"
}
